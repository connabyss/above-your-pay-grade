{
  "name": "above-your-pay-grade",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // The Hall of Failed Heists. A SQLite Durable Object works on the free plan and needs no setup.
  "durable_objects": { "bindings": [{ "name": "WALL", "class_name": "Wall" }] },
  // A free LLM writes PENNY's replies (Workers AI free allowance). It only sees FGA-allowed files.
  "ai": { "binding": "AI" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Wall"] }],
  // Offline dev without a Cloudflare login: `npx wrangler dev --env local` (no LLM, built-in lines).
  "env": { "local": { "durable_objects": { "bindings": [{ "name": "WALL", "class_name": "Wall" }] } } }
}
